# BEGIN Boxlet
# Everything down to END Boxlet is replaced when Boxlet is updated (PLAN.md D-140).
# Lines of your own go above BEGIN or below END, and are kept.

# Apache only. Nginx ignores this file; see README "Deployment" for try_files.
# URL rewriting is required: there is no fallback URL mode.

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

DirectoryIndex index.php

# If you change these rules, update the copy shown by public/index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Asked for as /public/… where Boxlet sits in the web root itself, behind the .htaccess
    # beside public/ (D-138). The same page without public/ is the real address, so this
    # one is sent there for good rather than answering the page at two addresses. The first
    # line is what tells that layout apart: only there is public/ inside the document root.
    RewriteCond %{DOCUMENT_ROOT}/public/index.php -f
    RewriteCond %{THE_REQUEST} ^\S+\s/public(?:/([^\s?]*))?[\s?]
    RewriteRule ^ /%1 [R=301,L]

    # Real files and directories (assets, cache, uploads) are served directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Without mod_rewrite, send 404s to index.php. It sees REDIRECT_STATUS=404 and shows
# how to enable rewriting instead of a bare server 404.
<IfModule !mod_rewrite.c>
    ErrorDocument 404 /index.php
</IfModule>

# An SVG logo opened on its own, as a page of this site, may run nothing (D-142). It is
# cleaned on upload and drawn as an <img>, where a browser runs nothing anyway; this is the
# third line, for the address typed or linked straight to the file. Needs mod_headers.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#/m/logo/[^/]+\.svg$#">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
        Header set X-Content-Type-Options "nosniff"
    </If>
</IfModule>
# HOW LONG A BROWSER KEEPS A FILE (D-202). Needs mod_headers. Only real files: a request a
# rewrite gave to index.php is served by index.php, whose name these do not match, so a page
# or a 404 is never kept. An address with ?v= (every stylesheet, script, picture and font
# Boxlet links) or a hash in its name (tokens.<hash>.css, site.<hash>.css, an SVG logo) changes
# when the file does, so it is kept a year and never asked about again. Anything else — what
# a stylesheet points at by a fixed name, as the admin's own font — is kept a week.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|avif|webp|jpe?g|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
        <If "%{QUERY_STRING} =~ /(^|&)v=[0-9a-f]+/ || %{REQUEST_URI} =~ m#/cache/(tokens|site)\.[0-9a-f]+\.css$# || %{REQUEST_URI} =~ m#/m/logo/[^/]+\.svg$#">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </FilesMatch>
</IfModule>
# COMPRESSED ON THE WAY OUT (D-204). Needs mod_deflate. A host that compresses nothing sent
# the visitor's stylesheets at 135 KB that gzip makes 36. Pictures and fonts are compressed
# already and are left alone.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
# END Boxlet
