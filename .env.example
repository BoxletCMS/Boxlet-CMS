# public/install.php writes .env for you. Copy this by hand only without the installer.

# Show readable stack traces on errors. Never enable on a public site.
APP_DEBUG=false

# Secret used to hash IPs and emails for the login rate limit. A long random string.
APP_KEY=

# mysql (recommended) or sqlite (small single-site installs)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# SQLite only. Relative paths resolve from the project root; never inside public/.
DB_PATH=storage/database.sqlite

# Optional: keep storage/ elsewhere. Relative paths resolve from the project root.
STORAGE_PATH=storage
