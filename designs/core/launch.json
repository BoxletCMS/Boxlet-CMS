                            "en": "Ship the release notes before the release",
                            "hr": "Objavite bilješke o izdanju prije izdanja"
                        },
                        "subheading": {
                            "en": "Changelog turns merged pull requests into notes your users read.",
                            "hr": "Changelog pretvara spojene pull requestove u bilješke koje korisnici čitaju."
                        },
                        "cta": {
                            "label": {
                                "en": "Start free",
                                "hr": "Počnite besplatno"
                            },
                            "url": "/contact"
                        }
                    }
                }
